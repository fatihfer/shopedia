# Template env untuk DEPLOY (VPS / server kampus).
# Cara pakai di server: cp .env.docker.example .env  lalu isi yang bertanda ✏️.
# File .env TIDAK di-commit ke git. Buat SEKALI per server, simpan baik-baik
# (ikut di-backup). Deploy ulang tidak perlu bikin lagi.

APP_NAME=Shopedia
APP_ENV=production
APP_KEY=                                          # ✏️ hasil `php artisan key:generate --show` (generate sekali, pakai di semua deploy)
APP_DEBUG=false
APP_URL=http://192.168.1.10:8080                 # ✏️ alamat yang dibuka browser/HP (domain atau IP + port)
APP_PORT=8080                                     # port host. 80 bila port 80 bebas (maka APP_URL tanpa :8080)

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db                                        # jangan diubah (nama service MySQL di compose)
DB_PORT=3306
DB_DATABASE=shopedia
DB_USERNAME=root
DB_PASSWORD=                                      # ✏️ password root MySQL (bebas, yang kuat)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@shopedia.test"
MAIL_FROM_NAME="Shopedia"
# Kalau mau OTP terkirim beneran, ganti ke SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=emailmu@gmail.com
# MAIL_PASSWORD="app password gmail"
# MAIL_ENCRYPTION=tls

VITE_APP_NAME="${APP_NAME}"

# Login Google (opsional — butuh internet). Tambahkan redirect URI-nya di Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://192.168.1.10:8080/auth/google/callback

WHATSAPP_ADMIN_NUMBER=                            # ✏️ nomor WA admin, cth: 62812xxxxxxxxx

# Midtrans QRIS (opsional — butuh internet + webhook publik)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# true = QR berisi link bayar demo (tanpa Midtrans, cocok untuk sidang/offline).
# false = QRIS Midtrans asli.
PAYMENT_DEMO_MODE=true
